---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import LevelNav from "../components/LevelNav.astro";
import StatusBar from "../components/StatusBar.astro";
import LevelCompleteBanner from "../components/LevelCompleteBanner.astro";
import Legend from "../components/Legend.astro";
import ResetButton from "../components/ResetButton.astro";
import SettingsDialog from "../components/SettingsDialog.astro";
import DeviceIntroDialog from "../components/DeviceIntroDialog.astro";
---

<Layout title="Can You Break the Internet?">
  <Header />

  <main>
    <LevelNav />

    <div class="diagram-panel">
      <svg
        id="network"
        tabindex="-1"
        viewBox="0 0 100 60"
        preserveAspectRatio="xMidYMid meet"
        role="img"
        aria-label="Network diagram: select a link to break or repair it"
      >
      </svg>

      <div class="zoom-controls">
        <button id="zoom-in" type="button" class="icon-button" aria-label="Zoom in">+</button>
        <button id="zoom-out" type="button" class="icon-button" aria-label="Zoom out">−</button>
      </div>

      <div id="tutorial-callout" class="tutorial-callout" role="status" hidden></div>
    </div>

    <StatusBar />
    <LevelCompleteBanner />

    <div class="diagram-actions">
      <ResetButton />
    </div>

    <Legend />
  </main>

  <SettingsDialog />
  <DeviceIntroDialog />

  <script src="../scripts/main.ts"></script>
</Layout>
