---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import SectionNav from "../components/SectionNav.astro";
import LevelSection from "../components/LevelSection.astro";
import { levels, type NodeType } from "../data/levels";

// Each device type is introduced once, above the first level that uses it —
// which is what the pop-up hints used to do, except now it stays on the page.
const seen = new Set<NodeType>();
const sections = levels.map((level, index) => {
  const newDevices = [...new Set(level.nodes.map((node) => node.type))].filter(
    (type) => !seen.has(type),
  );
  for (const type of newDevices) {
    seen.add(type);
  }
  const nextLevel = levels[index + 1];
  return {
    level,
    newDevices,
    next: nextLevel ? { id: nextLevel.id, title: nextLevel.title } : null,
  };
});
---

<Layout title="Can You Break the Internet?">
  <Header />
  <SectionNav />

  <main>
    <section id="intro" class="intro">
      <p class="intro-lead">
        "The internet is down" is almost never true. It's built to survive damage: when a link
        fails, traffic takes another way round, and you rarely notice.
      </p>
      <p>
        Nothing you ask for arrives in one direction only. Watch a diagram and you'll see the dark
        dot — your request — travel out to a server, and only once it lands does the hollow one set
        off back: the answer, returning through the same devices over the same links. That's why a
        page feels slow at twice the distance to the server, not once.
      </p>
      <p>
        Every level below is a network you can attack. <strong
          >Click any link to cut it</strong
        > — the diagram reroutes live and the status line tells you what's still standing. Keyboard:
        focus a diagram, use the arrow keys to move between devices and links, and Enter or Space to
        cut. On a touchscreen you can pinch to zoom and drag with a thumb to move around.
      </p>
      <p>
        A level is complete once you've cut it off entirely — every route to every server gone.
        Levels get harder as the networks get more like the real thing.
      </p>
    </section>

    {sections.map((props) => <LevelSection {...props} />)}
  </main>

  <script src="../scripts/main.ts"></script>
</Layout>
