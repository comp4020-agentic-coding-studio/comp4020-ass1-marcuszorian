---
import { levels } from "../data/levels";
---

<header class="app-header">
  <div class="app-header-start">
    <button
      id="nav-toggle"
      type="button"
      class="icon-button"
      aria-label="Open topics menu"
      aria-expanded="false"
      aria-controls="section-nav"
    >
      ☰
    </button>
    <svg
      class="header-glyph"
      viewBox="0 0 24 24"
      width="22"
      height="22"
      aria-hidden="true"
      focusable="false"
    >
      <circle cx="4" cy="12" r="2.4" fill="var(--accent-client)" />
      <circle cx="20" cy="5" r="2.4" fill="var(--accent-cdn-edge)" />
      <circle cx="20" cy="19" r="2.4" fill="var(--accent-datacenter)" />
      <path
        d="M6 12 L17.6 5.6 M6 12 L17.6 18.4"
        stroke="var(--color-muted)"
        stroke-width="1.4"
        fill="none"
      />
    </svg>
    <h1>Can You Break the Internet?</h1>
  </div>
  <div class="app-header-actions">
    <span id="level-counter" class="level-counter">✓ 0/{levels.length}</span>
    <button
      id="reset-progress"
      type="button"
      class="button button-danger"
      aria-label="Reset progress and repair every level"
    >
      ↺ <span class="reset-label">Reset progress</span>
    </button>
  </div>
</header>
