---
import { levels } from "../data/levels";
---

<header class="app-header">
  <div class="app-header-start">
    <button
      id="nav-toggle"
      type="button"
      class="icon-button"
      aria-label="Open topics menu"
      aria-expanded="false"
      aria-controls="section-nav"
    >
      ☰
    </button>
    <h1>Can You Break the Internet?</h1>
  </div>
  <div class="app-header-actions">
    <span id="level-counter" class="level-counter">✓ 0/{levels.length}</span>
    <button
      id="reset-progress"
      type="button"
      class="button button-danger"
      aria-label="Reset progress and repair every level"
    >
      ↺ <span class="reset-label">Reset progress</span>
    </button>
  </div>
</header>
