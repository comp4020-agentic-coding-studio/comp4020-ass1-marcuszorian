<dialog id="settings-dialog" class="dialog" aria-labelledby="settings-title">
  <h2 id="settings-title">Settings</h2>

  <label class="settings-row">
    <input id="hints-toggle" type="checkbox" />
    Show hints and tutorial callouts
  </label>

  <button id="reset-progress" type="button" class="button button-danger">
    Reset Progress
  </button>

  <button id="settings-close" type="button" class="button">Close</button>
</dialog>
